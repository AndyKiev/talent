cat > .gitignore << 'EOF'
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files
.env
.env.local
.env.*.local

# OS
Thumbs.db
.DS_Store

# Dependencies
node_modules

# Build outputs
dist
dist-ssr
build
*.local

# Python cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/auth/keys/

# Python virtual environment
.venv/
venv/

# Frontend cache
.tanstack/
.cache/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# Database files
*.db
*.sqlite
*.sqlite3

# Coverage reports
coverage/
.nyc_output/


# Temporary files
*.tmp
*.temp
*.bak
*.backup


# Package managers (uncomment if you want to ignore lock files)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# JWT Keys (sensitive!)
*.pem
*.key
*.crt
*.p12
backend/auth/keys/*.pem
backend/auth/keys/*.key

# Claude Code — local only, not pushed to remote
CLAUDE.md
.claude/
**/SKILL.md

# DeepSeek Code — local only, not pushed to remote
.deepseek/



# Messages live in the DB (msg_key/msg). translations.json is local scratch only.
translations.json

# Phase-2 data dump from talent-test (867KB, do not commit)
backend/scripts/scripts_talent_test_data.sql

# ─── OS / Editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ─── Docs ─────────────────────────────────────────────────────────────────────
README.md

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
backend/venv/
backend/__pycache__/
# ".venv/" only matches the repo root. Without these, the host's Windows
# backend/.venv is copied into the image and overwrites the Linux virtualenv
# poetry built, leaving "Command not found: alembic".
**/.venv/
**/venv/

# ─── JWT keys — generated at runtime, never bake into image ───────────────────
backend/auth/keys/

# ─── Database / local state ───────────────────────────────────────────────────
*.db
*.sqlite

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Frontend — not needed in backend image ───────────────────────────────────
frontend/
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.yarn/
frontend/.pnp*
frontend/.cache/
node_modules/

# ─── Docker files themselves ──────────────────────────────────────────────────
Dockerfile*
docker-compose*.yml
.dockerignore
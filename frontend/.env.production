# Empty on purpose: the app is origin-relative. Every axios call becomes
# /api/v1/... on whatever origin served the page, and nginx (nginx.conf) proxies
# /api/ to the backend. One origin -> no CORS, and the same build works from
# http://talent/, an IP, or any other hostname pointed at it.
# Was: http://talent:8004 (a second origin, which needed a per-env CORS list)
VITE_BACKEND_API_URL=

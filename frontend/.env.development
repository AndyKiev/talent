VITE_BACKEND_API_URL=
VITE_PROXY_TARGET=http://127.0.0.1:8004
# Hostnames the dev server accepts (vite blocks unknown Host headers with a 403).
# The FIRST entry is printed as the canonical dev URL on startup. Comma-separated.
# Point this name at this machine (corporate DNS record + DHCP reservation) so
# phone / tablet / PC all use ONE url. Until DNS lands, use the LAN IP instead.
VITE_ALLOWED_HOSTS=talent_dev

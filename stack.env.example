# Copy to stack.env and fill in. stack.env is gitignored - it holds credentials.
#
#   cp stack.env.example stack.env
#
# At home leave the proxy and extra-host values EMPTY: they point at the office
# network and nothing resolves outside it.

# DOCKER - corporate proxy (office only). Format:
#   http://<user>:<url-encoded-password>@proxy:3128
# Leave empty when working from home.
APP_HTTP_PROXY=
APP_HTTPS_PROXY=

# Internal hosts (office only) - "name:ip", leave empty at home
APP_EXTRA_HOST_PROXY=
APP_EXTRA_HOST_LNVUAHQ=
APP_EXTRA_HOST_LNVDC=

APP_NO_PROXY=localhost,127.0.0.1,.docker.internal,talent-backend-1,talent_test
APP_VITE_BACKEND_API_URL=talent-backend-1

# RUN CONFIG
APP_HOST=0.0.0.0
APP_PORT=8005
APP_CONFIG__RUN__PORT=8004
APP_CONFIG__RUN__HOST=0.0.0.0
